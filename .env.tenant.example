# =============================================================================
# .env.tenant.example — full ENV surface of one tenant stack (WP 02, REQ-ELN-27)
# =============================================================================
#
# One .env file passed to a tenant's docker-compose stack fully determines its
# Operator/Default configuration — no file mounts, no image baking. This file
# lists every PREFIX_KEY[_DEFAULT] pair introduced by the ENV-first packaging
# plus the pre-existing ENV surface, grouped per section.
#
# Semantics (REQ-ELN-28), per setting:
#   PREFIX_KEY          Absolute value — operator-fixed, wins over everything
#   PREFIX_KEY_DEFAULT  Default value  — used unless a per-deployment yml or an
#                       Absolute value overrides it
# Neither set -> the setting resolves to nil and the consuming feature is
# disabled/optional. Values: 'true'/'false' -> booleans, numbers -> numeric,
# '[...]'/'{...}' -> JSON (keys become symbols), '' -> explicit unset.
# Nested keys flatten with a double underscore (EDITOR_DOCSERVER__URI).
# Structure reference: config/app_config.yml.
#
# Lines marked SECRET carry credentials — inject them via your secret store,
# never commit real values.
#
# NOTE: this file supersedes .dockerenv.example (build-time compose variables)
# for tenant runtime configuration.

# --- converter (Labimotion converter-app) ------------------------------------
# CONVERTER_URL=http://converter:4000/
# CONVERTER_URL_DEFAULT=
# CONVERTER_PROFILE=                       # basic-auth user
# CONVERTER_SECRET_KEY=                    # SECRET — basic-auth password
# CONVERTER_TIMEOUT=300
# CONVERTER_EXT=[".txt",".xlsx"]           # JSON array of allowed extensions

# --- datacollectors ----------------------------------------------------------
# DATACOLLECTOR_SERVICES=[{"name":"mailcollector","cron":"5,20,35,50 * * * *"}]  # JSON
# DATACOLLECTOR_MAILCOLLECTOR__SERVER=imap.example.edu
# DATACOLLECTOR_MAILCOLLECTOR__MAIL_ADDRESS=service@example.edu
# DATACOLLECTOR_MAILCOLLECTOR__PASSWORD=   # SECRET — IMAP account
# DATACOLLECTOR_MAILCOLLECTOR__PORT=993
# DATACOLLECTOR_MAILCOLLECTOR__SSL=true
# DATACOLLECTOR_MAILCOLLECTOR__ALIASES=["alias@example.edu"]  # JSON array
# DATACOLLECTOR_KEYDIR=config/data_collector_keys
# DATACOLLECTOR_SFTPUSERS=[{"user":"u1","password":"p1"}]     # SECRET — JSON array
# DATACOLLECTOR_LOCALCOLLECTORS=[{"path":"/data/collector"}]  # JSON array

# --- editors (OnlyOffice document server + imprint) --------------------------
# EDITOR_DOCSERVER__ENABLE=false
# EDITOR_DOCSERVER__URI=http://onlyoffice.example.edu/
# EDITOR_DOCSERVER__API=web-apps/apps/api/documents/api.js
# EDITOR_DOCSERVER__CALLBACK_SERVER=       # must match PUBLIC_URL
# EDITOR_DOCSERVER__EXT={"text":["doc","docx"],"spreadsheet":["xls","xlsx"],"presentation":["ppt","pptx"]}
# EDITOR_INFO__ADDRESS=
# EDITOR_INFO__TITLE=
# EDITOR_INFO__NAME=
# EDITOR_INFO__LOGO=
# EDITOR_INFO__MAIL=
# EDITOR_INFO__WEBSITE=
# EDITOR_INFO__FEEDBACKURL=

# --- indigo_service ----------------------------------------------------------
# INDIGO_INDIGO_SERVICE_URL=http://indigo_service/
# INDIGO_INDIGO_SERVICE_URL_DEFAULT=

# --- inference (reaction prediction) -----------------------------------------
# INFERENCE_URL=127.0.0.1
# INFERENCE_PORT=5001

# --- ketcher_service (SVG rendering) -----------------------------------------
# KETCHER_SERVICE_URL=http://ketchersvc:4000/render
# KETCHER_SERVICE_URL_DEFAULT=

# --- profile_default (new-user layout) ---------------------------------------
# PROFILE_DEFAULT_LAYOUT={"layout":{"sample":1,"reaction":2}}  # JSON, whole tree

# --- radar (research-data archive) -------------------------------------------
# RADAR_URL=
# RADAR_CLIENT_ID=
# RADAR_CLIENT_SECRET=                     # SECRET
# RADAR_REDIRECT_URI=                      # must match tenant host
# RADAR_EMAIL=
# RADAR_BACKLINK=
# RADAR_PUBLISHER=
# RADAR_RESOURCE=
# RADAR_RESOURCETYPE=
# RADAR_SOFTWARENAME=
# RADAR_SOFTWAREVERSION=

# --- scifinder_n (CAS) -------------------------------------------------------
# SCIFINDER_PROVIDER__METADATA=
# SCIFINDER_PROVIDER__HOST=
# SCIFINDER_PROVIDER__CLIENT_ID=           # sensitive (CAS-issued id)
# SCIFINDER_PROVIDER__REDIRECT=            # must match tenant host
# SCIFINDER_PROVIDER__REDIRECT_HOST=

# --- shrine (attachment storage) ---------------------------------------------
# SHRINE_MAXIMUM_SIZE=100                  # MB upload cap
# SHRINE_CACHE=uploads/cache               # default: uploads/<env>[/cache]
# SHRINE_STORE=uploads

# --- spectra -----------------------------------------------------------------
# SPECTRA_CHEMSPECTRA__URL=http://spectra:3007
# SPECTRA_NMRIUMWRAPPER__URL=https://nmrium.nmrxiv.org

# --- storage (legacy file storage) -------------------------------------------
# STORAGE_MAXIMUM_SIZE=100
# STORAGE_PRIMARY_STORE=local
# STORAGE_SECONDARY_STORE=
# STORAGE_STORES={"tmp":{"data_folder":"tmp/uploads","thumbnail_folder":"tmp/uploads"},"local":{"data_folder":"uploads","thumbnail_folder":"uploads"}}
#   (or flattened: STORAGE_STORES__LOCAL__DATA_FOLDER=uploads ...; sftp/s3os
#    credentials in this tree are SECRET)

# --- structure_editors -------------------------------------------------------
# STRUCTURE_EDITOR_EDITORS={"ketcher":{"label":"Ketcher","extSrc":"/editors/ketcher/standalone/index.html"}}

# --- ui_components (opt-in feature flags) ------------------------------------
# UI_COMPONENT_WEIGHING_TASKS=false
# UI_COMPONENT_SAMPLE_EXPLORER=false

# --- user_props (name-abbreviation rules) ------------------------------------
# USER_PROP_NAME_ABBREVIATION__RESERVED_LIST=["CRR","CRS","CRD"]
# USER_PROP_NAME_ABBREVIATION__LENGTH_GROUP=[2,5]
# USER_PROP_NAME_ABBREVIATION__LENGTH_DEVICE=[2,6]
# USER_PROP_NAME_ABBREVIATION__LENGTH_DEFAULT=[2,3]        # Absolute (known key)
# USER_PROP_NAME_ABBREVIATION__LENGTH_DEFAULT_DEFAULT=[2,3] # Default tier of length_default
# USER_PROP_NAME_ABBREVIATION__FORMAT_ABBR=\A[a-zA-Z][a-zA-Z0-9\-_]*[a-zA-Z0-9]\Z
# USER_PROP_NAME_ABBREVIATION__FORMAT_ABBR_ERR_MSG=

# =============================================================================
# Pre-existing ENV surface (already ENV-first — inventory §4; unchanged here)
# =============================================================================

# --- tenant identity (WP 00) -------------------------------------------------
# MULTI_TENANT=true
# TENANT_ID=tenant-a
# TENANT_NAME=Tenant A
# TENANT_DOMAIN=tenant-a.example.edu
# TENANT_INBOUND_COLLABORATION=off
# TENANT_STORAGE_QUOTA_GB=0                # 0/unset = unlimited
# TENANT_GUEST_WRITE_ESCALATION=false      # P1 WP 06: allow guest grants beyond read-only (tenant-settable)
# TENANT_GUEST_MAX_PERMISSION_LEVEL=0      # cap when escalation is on; hard ceiling 3 (< manage_shares).
#                                          # Legacy: a positive value with the switch UNSET counts as escalation on.
# PUBLIC_URL=http://tenant-a.example.edu
# APPLICATION_TITLE=Chemotion

# --- secrets / crypto (WP 05) ------------------------------------------------
# SECRET_KEY_BASE=                         # SECRET — cookies, all JWTs, GateAPI
# OTP_SECRET_KEY=                          # SECRET — 2FA; required in production
# ONLY_OFFICE_SECRET_KEY_BASE=             # SECRET
# NOVNC_SECRET=                            # SECRET
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=    # SECRET
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=   # SECRET
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT= # SECRET
# METRICS_TOKEN=                           # SECRET — unset => /metrics 404s
# JWT_TTL_HOURS=336

# --- devise / sign-up --------------------------------------------------------
# DEVISE_SENDER=eln@example.edu
# DEVISE_DISABLED_SIGN_UP=
# DEVISE_NEW_ACCOUNT_INACTIVE=
# DEVISE_ALLOW_UNCONFIRMED=
# DEVISE_BCRYPT_COST=10
# DEVISE_PASSWORD_MIN_LENGTH=8
# DEVISE_PASSWORD_MAX_LENGTH=72
# DEVISE_MAXIMUM_ATTEMPTS=5

